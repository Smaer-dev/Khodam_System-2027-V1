rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function admin() {
      return ownProfile() && userProfile().active == true
        && userProfile().role in ['admin', 'service_admin', 'control_admin', 'priest', 'monitor'];
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create, update, delete: if admin();
    }

    match /{document=**} {
      allow read: if signedIn() && ownProfile() && userProfile().active == true;
      allow write: if admin();
    }
  }
}
